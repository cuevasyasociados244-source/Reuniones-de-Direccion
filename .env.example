# Copia este archivo a .env y rellena los valores.

# --- Base de datos (PostgreSQL / Neon) ---
# Neon entrega dos cadenas para el mismo proyecto:
#   - CON pooler (host con "-pooler"): úsala en DATABASE_URL (runtime / Vercel). Añade pgbouncer=true.
#   - DIRECTA (host sin "-pooler"): úsala en DIRECT_URL (migraciones de Prisma).
# Para Postgres local con Docker, ambas pueden apuntar a la misma cadena local.
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Sesiones ---
# Cambia esto en producción por una cadena larga y aleatoria.
SESSION_SECRET="cambia-esto-en-produccion-integra-rca"
